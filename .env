# .env.example
# Copy this file to .env and fill in your values.
# Load it in main.py with: from dotenv import load_dotenv; load_dotenv()
# Install:  pip install python-dotenv

# ── Storage ───────────────────────────────────────────────────────────────────
# "local" uses the local filesystem (default, no extra config needed)
# "s3"    uploads resumes to AWS S3 (fill in the S3 block below)
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads

# S3 — only required when STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=maverick-resumes

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=ATS_DB
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Connection Pool ───────────────────────────────────────────────────────────
DB_POOL_MIN=2
DB_POOL_MAX=10